# Copied/filled by deploy-remote.sh from server/.env.local + infra secrets.
# Do not commit real secrets.

APP_IMAGE_TAG=latest
SPRING_PROFILES_ACTIVE=dev
POSTGRES_DB=asset_management

DB_USERNAME=asset_app
DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

AUTH_ACCESS_TOKEN_SECRET=CHANGE_ME_AT_LEAST_32_BYTES_HEX
AUTH_ACCESS_TOKEN_TTL=2h
AUTH_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:80

APP_SECRET_ACTIVE_KEY_VERSION=1
APP_SECRET_ACTIVE_KEY_BASE64=CHANGE_ME

MQTT_CONNECTION_TEST_ALLOWED_PRIVATE_ADDRESSES=127.0.0.1,mosquitto
MQTT_USERNAME=asset_platform_local
MQTT_PASSWORD=CHANGE_ME
APP_DEV_BOOTSTRAP_MQTT_ENABLED=true
APP_DEV_BOOTSTRAP_MQTT_BROKER_URI=mqtt://mosquitto:1883
MQTT_PUBLIC_BROKER_HOST=mosquitto

API_PORT=8080
WORKER_PORT=8081
WEB_PORT=80
API_BIND_ADDRESS=0.0.0.0
WORKER_BIND_ADDRESS=127.0.0.1
WEB_BIND_ADDRESS=0.0.0.0
