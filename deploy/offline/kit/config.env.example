# 资产管理平台 — 离线安装配置
# 全新安装: sudo ./install_zh.sh  或  sudo ./install_en.sh
# 已有数据升级: sudo ./upgrade_zh.sh  或  sudo ./upgrade_en.sh（沿用正在使用的 config.env，不覆盖数据）
# 网页管理员账号、密码必须由安装人员设定：安装脚本会询问。
# 也可先填到 ROOT_USERNAME / ROOT_PASSWORD 再执行安装。留空则拒绝安装。
# 等号两边不要空格。密码含特殊字符时请用单引号包起来。

# 本机对外地址（网关填 MQTT 时用这个 IP 或域名）
# 留空则安装时自动取第一块网卡 IPv4
PUBLIC_HOST=

# 数据目录（Postgres / Redis / Mosquitto / 文档 / 备份）
DATA_DIR=/var/lib/asset-management

# 网页管理员（安装时询问；也可预先填写。留空则拒绝安装）
ROOT_USERNAME=
ROOT_PASSWORD=

# 网关连接 MQTT 的账号（安装时写入 Mosquitto，并自动配进平台）
MQTT_USERNAME=gw
MQTT_PASSWORD=GwMqtt2026AssetMgmt

# Postgres
POSTGRES_DB=asset_management
POSTGRES_USER=asset_app
POSTGRES_PASSWORD=PgAsset2026MgmtApp

# Redis
REDIS_PASSWORD=RedisAsset2026Mgmt

# 应用密钥（安装后不要改，改了已登录会话会失效）
AUTH_ACCESS_TOKEN_SECRET=d0d40b353d632fb56d4ede9ff3884055bfae348b6c088ccfc65c3b27620fa809
APP_SECRET_ACTIVE_KEY_BASE64=fiRe/KNewGJU7hc16n+EXrauhHzdu5xDrEr2Uyim6Yo=
APP_SECRET_ACTIVE_KEY_VERSION=1

# 可选 HTTPS。true 时还需要：
#   1) PUBLIC_HOST 填证书域名
#   2) 把 fullchain.pem、privkey.pem 放到 certs/
ENABLE_HTTPS=false

TZ=Asia/Shanghai

# 安装脚本语言（install_zh.sh / install_en.sh 会写入 zh 或 en）
# LANGUAGE=zh

