# Copy this file to .env and replace every CHANGE_ME value before startup.
COMPOSE_PROJECT_NAME=asset-management
TZ=Asia/Shanghai

# Images may be overridden for an internal registry. Pin digests in production.
POSTGRES_IMAGE=postgis/postgis:18-3.6
REDIS_IMAGE=redis:8-alpine
MOSQUITTO_IMAGE=eclipse-mosquitto:2

# Host bindings default to loopback so development services are not exposed to
# the LAN. Change them only when that exposure is intentional and protected.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
MQTT_BIND_ADDRESS=127.0.0.1
MQTT_PORT=1883
MQTT_WS_PORT=9001

POSTGRES_DB=asset_management
POSTGRES_USER=asset_app
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# This username and password must match the account generated in
# mosquitto/secrets/password_file. The password is used by the health check.
MQTT_USERNAME=asset_platform_local
MQTT_PASSWORD=CHANGE_ME_MQTT_PASSWORD
