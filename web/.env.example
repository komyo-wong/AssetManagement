# Copy to an environment-specific local file when overrides are required.
# Do not place API, database, MQTT, or signing credentials in Vite variables;
# every VITE_* value is visible to browser users.
# Login footer / help badge read package.json version, not this placeholder.
VITE_VERSION=1.0.7
VITE_PORT=3006
VITE_BASE_URL=/
VITE_ACCESS_MODE=frontend
VITE_WITH_CREDENTIALS=true
VITE_OPEN_ROUTE_INFO=false
VITE_API_URL=/
VITE_API_PROXY_URL=http://127.0.0.1:8080

